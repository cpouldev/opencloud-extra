+import MediaImage from '../../../src/components/Sources/MediaImage.vue'
+import { flushPromises } from '@vue/test-utils'
+import { defaultComponentMocks, defaultPlugins, mount } from '@opencloud-eu/web-test-helpers'
+import { MediaFile } from '../../../src/helpers/types'
+import Panzoom from '@panzoom/panzoom'
+
+vi.mock('@panzoom/panzoom', () => ({
+  default: vi.fn(() => ({
+    destroy: vi.fn(),
+    setStyle: vi.fn(),
+    getScale: () => 1,
+    getPan: () => ({ x: 0, y: 0 }),
+    zoomIn: vi.fn(),
+    zoomOut: vi.fn()
+  }))
+}))
+
+const file = (url = 'blob:first', changes = {}) =>
+  ({
+    id: '1',
+    name: 'drawing.svgz',
+    ext: 'svgz',
+    mimeType: 'image/svg+xml',
+    isImage: true,
+    isExtraRendered: true,
+    url,
+    resource: {},
+    ...changes
+  }) as MediaFile
+
+function render(mediaFile = file()) {
+  const mocks = defaultComponentMocks()
+  return mount(MediaImage, {
+    props: { file: mediaFile, currentImageRotation: 0 },
+    global: { plugins: [...defaultPlugins()], mocks, provide: mocks }
+  })
+}
+
+describe('rendered images in native image controls', () => {
+  it('treats rendered SVGZ as a raster preview', async () => {
+    const wrapper = render()
+    await flushPromises()
+    expect(wrapper.find('img').attributes('src')).toBe('blob:first')
+    expect(wrapper.find('inline-svg-stub').exists()).toBe(false)
+    wrapper.unmount()
+  })
+
+  it('reports an error for the current rendered image', async () => {
+    const wrapper = render()
+    await flushPromises()
+    await wrapper.get('img').trigger('error')
+    expect(wrapper.emitted('error')).toHaveLength(1)
+    wrapper.unmount()
+  })
+
+  it('ignores load and error events from a detached image', async () => {
+    const wrapper = render()
+    await flushPromises()
+    const previous = wrapper.get('img')
+    await wrapper.setProps({ file: file('blob:second', { id: '2' }) })
+    await flushPromises()
+    vi.mocked(Panzoom).mockClear()
+    await previous.trigger('error')
+    await previous.trigger('load')
+    await flushPromises()
+    expect(wrapper.emitted('error')).toBeUndefined()
+    expect(Panzoom).not.toHaveBeenCalled()
+    expect(wrapper.get('img').attributes('src')).toBe('blob:second')
+    wrapper.unmount()
+  })
+
+  it('ignores a detached image after returning to its cached URL', async () => {
+    const wrapper = render()
+    await flushPromises()
+    const previous = wrapper.get('img')
+    await wrapper.setProps({ file: file('blob:second', { id: '2' }) })
+    await flushPromises()
+    await wrapper.setProps({ file: file('blob:first') })
+    await flushPromises()
+    vi.mocked(Panzoom).mockClear()
+    await previous.trigger('error')
+    await previous.trigger('load')
+    await flushPromises()
+    expect(wrapper.emitted('error')).toBeUndefined()
+    expect(Panzoom).not.toHaveBeenCalled()
+    expect(wrapper.get('img').attributes('src')).toBe('blob:first')
+    wrapper.unmount()
+  })
+})
