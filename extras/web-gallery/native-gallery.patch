@@ -0,0 +1,268 @@
+import App from '../../../src/App.vue'
+import { flushPromises } from '@vue/test-utils'
+import { defaultComponentMocks, defaultPlugins, shallowMount } from '@opencloud-eu/web-test-helpers'
+import { FileContext } from '@opencloud-eu/web-pkg'
+import { Resource } from '@opencloud-eu/web-client'
+import { mock } from 'vitest-mock-extended'
+
+const { closeApp } = vi.hoisted(() => ({ closeApp: vi.fn() }))
+vi.mock('@opencloud-eu/web-pkg', async (importOriginal) => ({
+  ...(await importOriginal<any>()),
+  queryItemAsString: vi.fn(() => '1'),
+  createFileRouteOptions: vi.fn(() => ({ params: {}, query: {} })),
+  useAppNavigation: () => ({ closeApp })
+}))
+
+const resource = (name = 'artwork.ai', mimeType = 'application/postscript', changes = {}) =>
+  ({
+    id: '1',
+    fileId: '1',
+    name,
+    extension: name.split('.').pop(),
+    mimeType,
+    path: `/${name}`,
+    etag: 'revision-1',
+    permissions: 'RDNVW',
+    type: 'file',
+    canDownload: () => true,
+    hasPreview: () => true,
+    ...changes
+  }) as Resource
+
+function deferred() {
+  let resolve: (value: string) => void
+  const promise = new Promise<string>((done) => {
+    resolve = done
+  })
+  return { promise, resolve: (value: string) => resolve(value) }
+}
+
+function render(files = [resource()], loadPreview = vi.fn().mockResolvedValue('blob:preview')) {
+  const mocks = defaultComponentMocks()
+  mocks.$previewService.loadPreview.mockImplementation(loadPreview)
+  const getUrlForResource = vi.fn().mockResolvedValue('blob:original')
+  const revokeUrl = vi.fn()
+  const wrapper = shallowMount(App, {
+    props: {
+      currentFileContext: mock<FileContext>({ path: '/artwork.ai' }),
+      activeFiles: files,
+      isFolderLoading: false,
+      revokeUrl,
+      getUrlForResource,
+      loadFolderForFileContext: vi.fn()
+    },
+    global: { plugins: [...defaultPlugins()], mocks, provide: mocks }
+  })
+  return { wrapper, vm: wrapper.vm as any, loadPreview, getUrlForResource, revokeUrl }
+}
+
+describe('extra formats in the native gallery', () => {
+  it.each([
+    ['artwork.ai', 'application/pdf'],
+    ['layered.psd', 'application/octet-stream'],
+    ['font.woff2', 'font/woff2'],
+    ['source.nef', 'image/x-nikon-nef'],
+    ['document.pdf', 'application/pdf'],
+    ['document.docx', 'application/octet-stream'],
+    ['drawing.svgz', 'image/svg+xml'],
+    ['clip.mkv', 'video/x-matroska']
+  ])('renders %s with a fitted server preview', async (name, mimeType) => {
+    const { wrapper, vm, loadPreview, getUrlForResource } = render([resource(name, mimeType)])
+    await flushPromises()
+    expect(loadPreview).toHaveBeenCalledWith(
+      expect.objectContaining({
+        dimensions: [2048, 2048],
+        processor: 'fit'
+      }),
+      false,
+      false,
+      expect.any(AbortSignal)
+    )
+    expect(getUrlForResource).not.toHaveBeenCalled()
+    expect(vm.activeMediaFile).toMatchObject({
+      isExtraRendered: true,
+      isImage: true,
+      isVideo: false
+    })
+    expect(wrapper.find('photo-roll-stub').exists()).toBe(true)
+    expect(wrapper.find('media-controls-stub').exists()).toBe(true)
+    wrapper.unmount()
+  })
+
+  it('retains native image sizing', async () => {
+    const { wrapper, loadPreview, getUrlForResource, vm } = render([
+      resource('photo.jpg', 'image/jpeg')
+    ])
+    await flushPromises()
+    expect(loadPreview.mock.calls[0][0].dimensions).not.toEqual([2048, 2048])
+    expect(getUrlForResource).not.toHaveBeenCalled()
+    expect(vm.activeMediaFile.isExtraRendered).toBe(false)
+    wrapper.unmount()
+  })
+
+  it.each([
+    ['clip.mp4', 'video/mp4'],
+    ['audio.mp3', 'audio/mpeg']
+  ])('preserves native playback for %s', async (name, mimeType) => {
+    const { wrapper, loadPreview, getUrlForResource } = render([resource(name, mimeType)])
+    await flushPromises()
+    expect(loadPreview).not.toHaveBeenCalled()
+    expect(getUrlForResource).toHaveBeenCalled()
+    wrapper.unmount()
+  })
+
+  it.each([
+    ['native.svg', 'image/svg+xml', false],
+    ['photo.png', 'image/png', true]
+  ])('preserves native original handling for %s', async (name, mimeType, isInVault) => {
+    const { wrapper, loadPreview, getUrlForResource } = render([
+      resource(name, mimeType, { isInVault })
+    ])
+    await flushPromises()
+    expect(loadPreview).not.toHaveBeenCalled()
+    expect(getUrlForResource).toHaveBeenCalled()
+    wrapper.unmount()
+  })
+
+  it('does not fetch encrypted extra artwork', async () => {
+    const { wrapper, loadPreview, getUrlForResource, vm } = render([
+      resource('secret.ai', 'application/pdf', { isInVault: true })
+    ])
+    await flushPromises()
+    expect(loadPreview).not.toHaveBeenCalled()
+    expect(getUrlForResource).not.toHaveBeenCalled()
+    expect(vm.activeMediaFile.isError).toBe(true)
+    expect(wrapper.text()).toContain('Encrypted files cannot be rendered')
+    wrapper.unmount()
+  })
+
+  it('excludes files without download permission', async () => {
+    const { wrapper, loadPreview, getUrlForResource, vm } = render([
+      resource('private.ai', 'application/pdf', { canDownload: () => false })
+    ])
+    await flushPromises()
+    expect(vm.mediaFiles).toHaveLength(0)
+    expect(loadPreview).not.toHaveBeenCalled()
+    expect(getUrlForResource).not.toHaveBeenCalled()
+    wrapper.unmount()
+  })
+
+  it('excludes a folder with an artwork suffix', async () => {
+    const { wrapper, loadPreview, vm } = render([
+      resource('folder.ai', 'inode/directory', { type: 'folder', isFolder: true })
+    ])
+    await flushPromises()
+    expect(vm.mediaFiles).toHaveLength(0)
+    expect(loadPreview).not.toHaveBeenCalled()
+    wrapper.unmount()
+  })
+
+  it('shows conversion guidance with retry in the native error state', async () => {
+    const loadPreview = vi
+      .fn()
+      .mockRejectedValueOnce(new Error('failed'))
+      .mockResolvedValue('blob:retry')
+    const { wrapper, vm } = render([resource()], loadPreview)
+    await flushPromises()
+    expect(wrapper.text()).toContain('Failed to load')
+    expect(wrapper.text()).toContain('Create PDF Compatible File')
+    await wrapper.get('[arialabel="Retry preview"]').trigger('click')
+    await flushPromises()
+    expect(vm.activeMediaFile).toMatchObject({
+      isError: false,
+      isLoading: false,
+      url: 'blob:retry'
+    })
+    expect(loadPreview).toHaveBeenCalledTimes(2)
+    wrapper.unmount()
+  })
+
+  it('discards a preview that finishes after native navigation', async () => {
+    const first = deferred()
+    const loadPreview = vi.fn().mockReturnValueOnce(first.promise).mockResolvedValue('blob:second')
+    const { wrapper, vm, revokeUrl } = render(
+      [resource(), resource('next.psd', 'image/vnd.adobe.photoshop', { id: '2', fileId: '2' })],
+      loadPreview
+    )
+    await flushPromises()
+    vm.goToNext()
+    await flushPromises()
+    expect(loadPreview.mock.calls[0][3].aborted).toBe(true)
+    first.resolve('blob:stale')
+    await flushPromises()
+    expect(revokeUrl).toHaveBeenCalledWith('blob:stale')
+    expect(vm.activeMediaFile.url).toBe('blob:second')
+    wrapper.unmount()
+  })
+
+  it('cancels a pending preview when returning to a cached image', async () => {
+    const second = deferred()
+    const loadPreview = vi
+      .fn()
+      .mockResolvedValueOnce('blob:first')
+      .mockReturnValueOnce(second.promise)
+    const { wrapper, vm, revokeUrl } = render(
+      [resource(), resource('next.psd', 'image/vnd.adobe.photoshop', { id: '2', fileId: '2' })],
+      loadPreview
+    )
+    await flushPromises()
+    vm.goToNext()
+    await flushPromises()
+    vm.goToPrev()
+    await flushPromises()
+    expect(loadPreview.mock.calls[1][3].aborted).toBe(true)
+    second.resolve('blob:stale')
+    await flushPromises()
+    expect(vm.activeMediaFile.url).toBe('blob:first')
+    expect(loadPreview).toHaveBeenCalledTimes(2)
+    expect(revokeUrl).toHaveBeenCalledWith('blob:stale')
+    wrapper.unmount()
+  })
+
+  it('replaces a cached preview after the source revision changes', async () => {
+    const loadPreview = vi.fn().mockResolvedValueOnce('blob:first').mockResolvedValue('blob:new')
+    const { wrapper, vm, revokeUrl } = render([resource()], loadPreview)
+    await flushPromises()
+    await wrapper.setProps({
+      activeFiles: [resource('artwork.ai', 'application/postscript', { etag: 'revision-2' })]
+    })
+    await flushPromises()
+    expect(revokeUrl).toHaveBeenCalledWith('blob:first')
+    expect(loadPreview.mock.calls[1][0].resource.etag).toBe('revision-2')
+    expect(vm.activeMediaFile.url).toBe('blob:new')
+    wrapper.unmount()
+  })
+
+  it('releases a late URL after closing the native gallery', async () => {
+    const pending = deferred()
+    const loadPreview = vi.fn().mockReturnValue(pending.promise)
+    const { wrapper, revokeUrl } = render([resource()], loadPreview)
+    await flushPromises()
+    wrapper.unmount()
+    pending.resolve('blob:late')
+    await flushPromises()
+    expect(loadPreview.mock.calls[0][3].aborted).toBe(true)
+    expect(revokeUrl).toHaveBeenCalledWith('blob:late')
+  })
+
+  it('closes on Space from the gallery stage', async () => {
+    const { wrapper } = render()
+    await flushPromises()
+    await wrapper.get('[tabindex="-1"]').trigger('keydown', { key: ' ' })
+    expect(closeApp).toHaveBeenCalledOnce()
+    wrapper.unmount()
+  })
+
+  it.each(['input', 'textarea', 'button', 'video', 'audio'])(
+    'leaves Space to a focused %s',
+    async (tag) => {
+      const { wrapper } = render()
+      await flushPromises()
+      const control = document.createElement(tag)
+      wrapper.get('[tabindex="-1"]').element.append(control)
+      control.dispatchEvent(new KeyboardEvent('keydown', { key: ' ', bubbles: true }))
+      expect(closeApp).not.toHaveBeenCalled()
+      wrapper.unmount()
+    }
+  )
+})
