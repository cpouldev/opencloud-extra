+import type { Resource } from '@opencloud-eu/web-client'
+
+export const previewExtensions: string[]
+export const officeExtensions: string[]
+export const fallbackExtensions: string[]
+export const mediaFallbackExtensions: string[]
+
+type FormatResource = Partial<Pick<Resource, 'name' | 'extension' | 'isInVault' | 'canDownload'>>
+
+export function extensionOf(resource?: FormatResource): string
+export function unavailableReason(resource?: FormatResource): string
+export function canPreviewFallback(resource?: Resource): boolean
+export function conversionHint(resource?: FormatResource): string
diff --git a/packages/web-app-preview/tests/unit/extra/gallery.spec.ts b/packages/web-app-preview/tests/unit/extra/gallery.spec.ts
