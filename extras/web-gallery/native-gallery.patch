index 0000000..c92f40e
--- /dev/null
+++ b/packages/web-app-preview/src/composables/extraFiles.ts
@@ -0,0 +1,48 @@
+import type { Resource } from '@opencloud-eu/web-client'
+import { mimeTypes } from '../mimeTypes'
+import {
+  conversionHint,
+  extensionOf,
+  fallbackExtensions,
+  mediaFallbackExtensions,
+  previewExtensions
+} from '../extra/formats.js'
+
+const renderedExtensions = new Set([...previewExtensions, ...fallbackExtensions, 'pdf'])
+const fallbackMedia = new Set(mediaFallbackExtensions)
+
+// Native images and supported media keep their existing decoder/player. The
+// extra formats use only a rendered image; their original stays on the server.
+export function isExtraRenderedFile(resource: Resource) {
+  const extension = extensionOf(resource)
+  return (
+    renderedExtensions.has(extension) ||
+    (fallbackMedia.has(extension) && !mimeTypes.includes(resource.mimeType?.toLowerCase()))
+  )
+}
+
+export function canPreviewFile(resource: Resource) {
+  if (resource.isFolder || (resource.type && resource.type !== 'file')) return false
+  try {
+    return Boolean(resource.canDownload?.())
+  } catch {
+    return false
+  }
+}
+
+export function extraPreviewHint(resource: Resource) {
+  return resource.isInVault
+    ? 'Encrypted files cannot be rendered on the server.'
+    : conversionHint(resource)
+}
+
+export function previewRevision(resource: Resource) {
+  return JSON.stringify([
+    resource.id,
+    resource.etag,
+    resource.name,
+    resource.mimeType,
+    resource.permissions,
+    resource.isInVault
+  ])
+}
